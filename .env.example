# Model calls go through OpenRouter (OpenAI-compatible), same as the support agent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# AgentMail (Evan's org key; the verified domain is agent.fieldpulse.com).
AGENTMAIL_API_KEY=

# Supabase (shared FieldPulse project). Service key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Comma-separated AgentMail inbox ids to subscribe to. Each must match a row in
# parser_customers.inbox_id, which is how an email is tied to a customer.
PARSER_INBOX_IDS=parser_test@agentmail.to

PORT=3000

# Universal Auth (FieldPulse Google sign-in). Leave unset locally for an open API.
# Backend verifies tokens against the central project's public keys.
FP_AUTH_URL=https://wrxtvqvrpjhkicjdwqoc.supabase.co
# Frontend (baked in at build time). The publishable key is browser-safe by design.
VITE_FP_AUTH_URL=https://wrxtvqvrpjhkicjdwqoc.supabase.co
VITE_FP_AUTH_PUBLISHABLE_KEY=
